# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env

# Generated data (large, regenerable — don't commit)
data-pipeline/*.jsonl
!data-pipeline/seeds_example.txt

# Model artifacts (large binaries — don't commit to git)
model/*.task
model/*.tflite
model/checkpoints/

# Local-only third-party training media — never committed or distributed.
data-pipeline/raw-media/
*.mkv
*.mp4
*.srt
*.ass

# Internal design/planning docs — kept out of the public repo entirely,
# committed locally only on the docs-private branch (never pushed).
docs/

# Local backup bundles / scrub clones — never commit
_backup/
_scrub-tmp/

# OS
.DS_Store
Thumbs.db
